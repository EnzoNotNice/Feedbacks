# توكن البوت من بوابة مطوري ديسكورد
DISCORD_TOKEN=

# معرف التطبيق الخاص بالبوت (Client ID)
DISCORD_CLIENT_ID=

# معرف السيرفر الاختياري (اتركه فارغا للتشغيل في جميع السيرفرات)
DISCORD_GUILD_ID=

# مسار قاعدة البيانات المحلية
DATABASE_PATH=./data/feedbacks.db

# حالة البوت الظاهرة في ديسكورد
BOT_STATUS_TEXT=آراء العملاء

# اسم المتجر أو العلامة التجارية الافتراضي
BRAND_NAME=Enzo Feedbacks

# مهم جدا: احذف كلمة .example من اسم الملف ليصبح .env فقط قبل تشغيل البوت
